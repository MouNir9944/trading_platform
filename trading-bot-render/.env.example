# --- Access control (REQUIRED in production) ---
# The dashboard can place real orders, so the whole app sits behind HTTP Basic auth.
APP_USERNAME=admin
APP_PASSWORD=change-me

# --- Paper trading needs no keys at all: it's a local, simulated account with capital you set yourself in ---
# --- the app, trading against real live prices. No Binance keys are required unless you use live mode.    ---

# --- Binance live keys (only needed if you use live mode; restrict to Spot trading, no withdrawals) ---
BINANCE_API_KEY_real=your-live-key
BINANCE_API_SECRET_real=your-live-secret

# --- Binance live FUTURES keys (only needed for live futures; falls back to the live Spot key pair above if unset) ---
# BINANCE_FUTURES_API_KEY_real=
# BINANCE_FUTURES_API_SECRET_real=

# Which account the app starts in before you toggle it in the UI (true = paper, no real money)
BINANCE_TESTNET=true
TRADING_SYMBOL=BTCUSDT

# Where orders.json / order_limits.json / account_mode.txt live.
# On Render set this to the persistent disk mount path (/var/data).
# DATA_DIR=./data
MONGODB_URI=mongodb://localhost:27017/

# --- Notifications (AMD Bot / strategy signals, orders, fills) ---
# Create a bot with @BotFather, then message it once on Telegram to get your chat id (see README).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Or/also: any https URL that accepts a JSON POST (Discord, Slack, Zapier, Make, your own server)
# NOTIFY_WEBHOOK_URL=
